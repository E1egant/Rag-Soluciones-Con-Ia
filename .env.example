# Copiar este archivo como ".env" y completar UNA de las dos claves.
#
# Opción recomendada (gratis, sin tarjeta de crédito):
#   1. Entrar a https://aistudio.google.com/app/apikey con una cuenta Google.
#   2. Crear una API key y pegarla abajo en GEMINI_API_KEY.
#   3. Modelo usado: gemini-2.5-flash (capa gratuita permanente).
GEMINI_API_KEY=

# Opción alternativa (de pago, requiere créditos en la cuenta):
#   API key de Anthropic desde https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Si ninguna de las dos está configurada, el sistema corre en "modo demo"
# (ver src/generator.py): ejecuta todo el pipeline de recuperación pero no
# genera texto real. Útil para tests, no válido como entrega final.
